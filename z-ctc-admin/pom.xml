<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-ctc</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>z-ctc-admin</artifactId>
    <name>z-ctc-admin</name>
    <description>4A 中心 - admin 入口：依赖 z-ctc-web, 复用其自动装配; 同时作为独立 Spring Boot 启动模块
        (z-ctc-admin-*-exec.jar) 供 Docker 部署
    </description>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
            admin 是 standalone demo + docker 镜像源，永远不上 Maven Central。
            保留在 reactor 以享受统一构建（mvn package / install / -pl admin -am 都能用），
            但 deploy 阶段自动跳过。
            详见 lead/005_技术架构/005_前端工程与中间件部署架构规范.md §2
        -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- 原来这里还有一份 <z-ctc.version>${revision}</z-ctc.version>：子 pom 的 property 会遮蔽
             父 pom 的同名键，而根 pom 那份已随迁移删掉（自家坐标改由根 DM 的 ${project.version}
             下发），留着它只会让下面那条 z-ctc-web 引用点解析到一个没人维护的键上。 -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                FEATURE034 T4: 锁定 mybatis-plus 全套 3.5.3.1 + jsqlparser 4.6.
                mybatis-plus 3.5.7 编译期依赖 jsqlparser 4.9 的 SelectItem API,
                与 jsqlparser 4.6 不兼容, 启动时会抛 InstantiationError.
            -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus</artifactId>
                <version>3.5.3.1</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-core</artifactId>
                <version>3.5.3.1</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-extension</artifactId>
                <version>3.5.3.1</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-annotation</artifactId>
                <version>3.5.3.1</version>
            </dependency>
            <dependency>
                <groupId>com.github.jsqlparser</groupId>
                <artifactId>jsqlparser</artifactId>
                <version>4.6</version>
            </dependency>
            <!-- 同一刀的另外两格：地板的直接 DM 条目把 mybatis 钉 3.5.16 / mybatis-spring 钉 2.0.6
                 （那是地板给 mybatis-plus 3.5.7 配的配套），而 3.5.3.1 那套配套是 3.5.10 / 2.1.2 ——
                 迁移实测 admin 树里这两格被拽走。按"分歧要写成直接条目才顶得住继承来的直接 DM"补回来，
                 admin 的运行期栈与迁移前逐字相同。 -->
            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis</artifactId>
                <version>3.5.10</version>
            </dependency>
            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis-spring</artifactId>
                <version>2.1.2</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- admin 引用 z-ctc 同仓 web starter（与 z-schedule-admin 不同，z-ctc 没有独立的
             z-ctc-spring-boot-starter，admin 直接依赖 z-ctc-web）。版本由根 DM 的
             ${project.version} 下发，不在这里写字面值。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-ctc-web</artifactId>
        </dependency>

        <!--
            Spring Boot Web + Log4j2. 排除 spring-boot-starter-logging (默认 Logback)
            强制走 log4j2, 与 z-meta-admin / z-mist-admin 保持一致 (FEATURE012 / FEATURE034 T4).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-starter</artifactId>
        </dependency>

        <!-- knife4j 版本由地板下发（z-boot-dependencies 的直接条目 4.1.0，与本仓迁移前那份根 DM
             面值逐字相同），原来这里的字面 <version> 顶得过一切 DM，删掉。 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.github.jsqlparser</groupId>
                    <artifactId>jsqlparser</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
            <version>4.6</version>
        </dependency>

        <!-- 这里原来字面钉 z-boot-datasource-starter 1.0.17：模块 pom 的 <version> 顶得过一切 DM，
             根 pom 跟不跟父链抬到 1.0.19 都会被这一行拽回去（本仓唯一一处 z-boot 字面量）。删掉后
             由 parent 按坐标下发 1.0.19。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-datasource-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-core</artifactId>
        </dependency>

        <!-- FEATURE: AuthnController 校验密码需要 spring-security-crypto 的 BCrypt -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- FEATURE034 T4: 健康检查 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Dev profile: H2 内存数据库 + dev profile 用 DevDataSourceConfig 绕过
            z-boot-datasource-starter 强制 MySQL. 生产用真 MySQL, 不引入 H2 也行。
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 这里原来是一条字面 maven-compiler-plugin 3.10.1 声明（与 sso/web 同形，模块 pom 的
                 <version> 顶得过一切 DM），删掉后统一由 z-boot-parent 的 pluginManagement 下发 3.11.0。 -->
            <!--
                V2 改造：frontend-maven-plugin 在 generate-resources 阶段跑 npm build
                workingDirectory 指向 _frontend/z-ctc-suit/（仓根下，不在 reactor 内）
                产物 dist/ → 由下面 maven-resources-plugin 复制到 src/main/resources/static/
                详见 lead/005_技术架构/005_前端工程与中间件部署架构规范.md §1.2 / §6.1 V2
            -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.0</version>
                <configuration>
                    <workingDirectory>${project.basedir}/../_frontend/z-ctc-suit</workingDirectory>
                    <installDirectory>${project.build.directory}/frontend</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <nodeVersion>v18.17.0</nodeVersion>
                            <npmVersion>9.6.7</npmVersion>
                        </configuration>
                    </execution>
                    <!--
                        兄弟包 z-ctc-component 必须先构建出 dist/。
                        它不在 reactor 里（无 pom 引用它），此前没有任何一步会构建它，
                        而消费端 package.json 依赖 "file:../z-ctc-component"、
                        该包 main/module 都指向 ./dist ⇒ 干净机器上 dist 根本不存在，
                        消费端 vite build 报
                        "Failed to resolve entry for package @yuku123/z-ctc-component"，
                        整个 mvn install 挂在这里（表现为一堆 [ERROR]，与 javac 无关）。

                        同 phase 内的执行顺序按声明顺序，故这两个 execution 必须排在
                        下面 npm-install / npm-run-build 之前。
                    -->
                    <execution>
                        <id>npm-install-component</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <workingDirectory>${project.basedir}/../_frontend/z-ctc-component</workingDirectory>
                            <arguments>install --no-audit --no-fund</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-run-build-component</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <workingDirectory>${project.basedir}/../_frontend/z-ctc-component</workingDirectory>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>install --install-links</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-run-build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                V2 改造：把 _frontend/z-ctc-suit/dist/ 复制到 target/classes/static/
                （不复制到 src/main/resources/static/，避免污染源码目录 + git 噪声）
                必须在 frontend-maven-plugin 跑完之后（process-resources > generate-resources）
                且在默认 maven-resources-plugin 之后（process-resources 阶段默认 src/main/resources -> target/classes）
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-frontend-dist</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../_frontend/z-ctc-suit/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                与 z-meta-admin 一致: repackage 产出 *-exec.jar (Spring Boot 可执行 fat jar)
                普通 jar 仍作为 library 暴露, 不影响 z-opc-main-starter 通过 spring.factories
                加载 ZCompanyCtcWebAutoConfiguration / SsoAutoConfiguration.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- 不写版本时 Maven 会去解析"最新可用"版本(实测抓到 4.2.0-M2,其 mojo 是 class 61,
                     JDK 8 上直接跑不起来)。钉回本仓的 Boot 线。 -->
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>com.zifang.z.ctc.admin.ZCtcAdminApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

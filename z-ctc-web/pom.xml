<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-ctc</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>z-ctc-web</artifactId>
    <version>${revision}</version>
    <name>z-ctc-web</name>
    <description>4A 中心 - web 模块：用户面向 API（AuthController 登录/注册）+ DataSource + SqlSessionFactory 主装配点
    </description>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Jackson annotations (本模块 src/main/java 用 @JsonIgnore 等)。原来这里字面钉 2.18.6
             —— 模块 pom 的 <version> 顶得过一切 DM，是把本仓自己钉在地板之外；删掉后由地板的
             jackson-bom 供，面值同为 2.18.6（tree 实测）。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <!-- Jackson databind (本模块 src/main/java 用 ObjectMapper / JsonNode 等) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Log4j2 API (本模块 src/main/java 含 LogManager.getLogger 调用) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-ctc-common</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-ctc-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-ctc-sso</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-datasource-starter</artifactId>
            </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            本模块原先零可执行测试：VerifyCodeService 的验证码生成（曾用 Math.random）、
            AuthnController 的登录限流都没有任何回归闸。补上测试依赖。
            注：z-ctc-core / z-ctc-sso 下形如 *Test 的类里有两个是 public static void main
            自测（AcDeptTreeServiceTest / AcStaffSimpleServiceTest / JwtUtilTest），
            surefire 不执行它们，"No tests to run" 就是它们造成的 —— 别被那个数字骗了。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- 迁移删掉了本模块那条 maven-compiler-plugin 3.10.1 的字面 <version> 声明（模块 pom 里的
         <version> 顶得过一切 DM，留着它根 pom 抬到 3.11.0 也管不到这一层），现在跟
         z-boot-parent 的 pluginManagement 走。 -->
</project>